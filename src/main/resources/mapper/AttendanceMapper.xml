<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.pcim.mapper.AttendanceMapper">

    <resultMap id="BaseResultMap" type="com.example.pcim.entity.Attendance">
        <id column="id" property="id" />
        <result column="prisoner_id" property="prisonerId" />
        <result column="prisoner_no" property="prisonerNo" />
        <result column="name" property="name" />
        <result column="cell" property="cell" />
        <result column="roll_call_time" property="rollCallTime" />
        <result column="status" property="status" />
        <result column="check_in_time" property="checkInTime" />
        <result column="check_out_time" property="checkOutTime" />
        <result column="remark" property="remark" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
    </resultMap>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT * FROM prison_attendance WHERE id = #{id}
    </select>

    <select id="selectList" resultMap="BaseResultMap">
        SELECT * FROM prison_attendance
        <where>
            <if test="keyword != null and keyword != ''">
                AND (name LIKE CONCAT('%', #{keyword}, '%') OR prisoner_no LIKE CONCAT('%', #{keyword}, '%'))
            </if>
            <if test="cell != null and cell != ''">
                AND cell = #{cell}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
        ORDER BY roll_call_time DESC
    </select>

    <select id="selectCount" resultType="java.lang.Long">
        SELECT COUNT(*) FROM prison_attendance
        <where>
            <if test="keyword != null and keyword != ''">
                AND (name LIKE CONCAT('%', #{keyword}, '%') OR prisoner_no LIKE CONCAT('%', #{keyword}, '%'))
            </if>
            <if test="cell != null and cell != ''">
                AND cell = #{cell}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
    </select>

    <insert id="insert" parameterType="com.example.pcim.entity.Attendance">
        INSERT INTO prison_attendance (prisoner_id, prisoner_no, name, cell, roll_call_time, status, check_in_time, check_out_time, remark, create_time, update_time)
        VALUES (#{prisonerId}, #{prisonerNo}, #{name}, #{cell}, #{rollCallTime}, #{status}, #{checkInTime}, #{checkOutTime}, #{remark}, NOW(), NOW())
    </insert>

    <update id="update" parameterType="com.example.pcim.entity.Attendance">
        UPDATE prison_attendance SET
        <if test="rollCallTime != null">roll_call_time = #{rollCallTime},</if>
        <if test="status != null">status = #{status},</if>
        <if test="checkInTime != null">check_in_time = #{checkInTime},</if>
        <if test="checkOutTime != null">check_out_time = #{checkOutTime},</if>
        <if test="remark != null">remark = #{remark},</if>
        update_time = NOW()
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM prison_attendance WHERE id = #{id}
    </delete>

</mapper>
