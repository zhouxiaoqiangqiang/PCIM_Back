<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  教育学习 Mapper XML
  对应表：prison_education
-->
<mapper namespace="com.example.pcim.mapper.EducationMapper">

    <!-- 结果映射：数据库字段名（下划线） 与 Java 属性名（驼峰）之间的映射 -->
    <resultMap id="BaseResultMap" type="com.example.pcim.entity.Education">
        <id column="id" property="id" />
        <result column="prisoner_no" property="prisonerNo" />
        <result column="name" property="name" />
        <result column="cell" property="cell" />
        <result column="course_name" property="courseName" />
        <result column="edu_date" property="eduDate" />
        <result column="duration" property="duration" />
        <result column="teacher" property="teacher" />
        <result column="score" property="score" />
        <result column="result" property="result" />
        <result column="remark" property="remark" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
    </resultMap>

    <!-- 根据主键查询单条记录 -->
    <select id="selectById" resultMap="BaseResultMap">
        SELECT * FROM prison_education WHERE id = #{id}
    </select>

    <!-- 查询教育学习列表，支持 keyword/result 动态筛选，按创建时间倒序 -->
    <select id="selectList" resultMap="BaseResultMap">
        SELECT * FROM prison_education
        <where>
            <!-- 关键字：模糊匹配监犯编号、姓名、课程名称 -->
            <if test="keyword != null and keyword != ''">
                AND (prisoner_no LIKE CONCAT('%', #{keyword}, '%')
                     OR name LIKE CONCAT('%', #{keyword}, '%')
                     OR course_name LIKE CONCAT('%', #{keyword}, '%'))
            </if>
            <!-- 学习结果筛选 -->
            <if test="result != null and result != ''">
                AND result = #{result}
            </if>
        </where>
        ORDER BY create_time DESC
    </select>

    <!-- 查询总记录数，条件与 selectList 保持一致 -->
    <select id="selectCount" resultType="java.lang.Long">
        SELECT COUNT(*) FROM prison_education
        <where>
            <if test="keyword != null and keyword != ''">
                AND (prisoner_no LIKE CONCAT('%', #{keyword}, '%')
                     OR name LIKE CONCAT('%', #{keyword}, '%')
                     OR course_name LIKE CONCAT('%', #{keyword}, '%'))
            </if>
            <if test="result != null and result != ''">
                AND result = #{result}
            </if>
        </where>
    </select>

    <!-- 新增教育学习记录 -->
    <insert id="insert" parameterType="com.example.pcim.entity.Education">
        INSERT INTO prison_education
        (prisoner_no, name, cell, course_name, edu_date, duration, teacher, score, result, remark, create_time, update_time)
        VALUES
        (#{prisonerNo}, #{name}, #{cell}, #{courseName}, #{eduDate}, #{duration}, #{teacher}, #{score}, #{result}, #{remark}, NOW(), NOW())
    </insert>

    <!-- 更新教育学习记录，所有字段按需动态更新 -->
    <update id="update" parameterType="com.example.pcim.entity.Education">
        UPDATE prison_education SET
        <if test="prisonerNo != null">prisoner_no = #{prisonerNo},</if>
        <if test="name != null">name = #{name},</if>
        <if test="cell != null">cell = #{cell},</if>
        <if test="courseName != null">course_name = #{courseName},</if>
        <if test="eduDate != null">edu_date = #{eduDate},</if>
        <if test="duration != null">duration = #{duration},</if>
        <if test="teacher != null">teacher = #{teacher},</if>
        <if test="score != null">score = #{score},</if>
        <if test="result != null">result = #{result},</if>
        <if test="remark != null">remark = #{remark},</if>
        update_time = NOW()
        WHERE id = #{id}
    </update>

    <!-- 根据主键删除 -->
    <delete id="deleteById">
        DELETE FROM prison_education WHERE id = #{id}
    </delete>

</mapper>
