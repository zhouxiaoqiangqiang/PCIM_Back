<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  探视登记 Mapper XML
  对应表：prison_visit
-->
<mapper namespace="com.example.pcim.mapper.VisitMapper">

    <!-- 结果映射：数据库字段名（下划线） 与 Java 属性名（驼峰）之间的映射 -->
    <resultMap id="BaseResultMap" type="com.example.pcim.entity.Visit">
        <id column="id" property="id" />
        <result column="prisoner_no" property="prisonerNo" />
        <result column="name" property="name" />
        <result column="cell" property="cell" />
        <result column="visitor_name" property="visitorName" />
        <result column="visitor_id_card" property="visitorIdCard" />
        <result column="relation" property="relation" />
        <result column="visit_time" property="visitTime" />
        <result column="remark" property="remark" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
    </resultMap>

    <!-- 根据主键查询单条记录 -->
    <select id="selectById" resultMap="BaseResultMap">
        SELECT * FROM prison_visit WHERE id = #{id}
    </select>

    <!-- 查询探视登记列表，支持 keyword/relation/date 动态筛选，按 visit_time 倒序 -->
    <select id="selectList" resultMap="BaseResultMap">
        SELECT * FROM prison_visit
        <where>
            <!-- 关键字：模糊匹配监犯编号、姓名、探视人姓名 -->
            <if test="keyword != null and keyword != ''">
                AND (prisoner_no LIKE CONCAT('%', #{keyword}, '%')
                     OR name LIKE CONCAT('%', #{keyword}, '%')
                     OR visitor_name LIKE CONCAT('%', #{keyword}, '%'))
            </if>
            <!-- 与监犯关系筛选 -->
            <if test="relation != null and relation != ''">
                AND relation = #{relation}
            </if>
            <!-- 探视日期（等于条件，按天匹配） -->
            <if test="date != null and date != ''">
                AND DATE(visit_time) = #{date}
            </if>
        </where>
        ORDER BY visit_time DESC
    </select>

    <!-- 查询总记录数，条件与 selectList 保持一致 -->
    <select id="selectCount" resultType="java.lang.Long">
        SELECT COUNT(*) FROM prison_visit
        <where>
            <if test="keyword != null and keyword != ''">
                AND (prisoner_no LIKE CONCAT('%', #{keyword}, '%')
                     OR name LIKE CONCAT('%', #{keyword}, '%')
                     OR visitor_name LIKE CONCAT('%', #{keyword}, '%'))
            </if>
            <if test="relation != null and relation != ''">
                AND relation = #{relation}
            </if>
            <if test="date != null and date != ''">
                AND DATE(visit_time) = #{date}
            </if>
        </where>
    </select>

    <!-- 新增探视登记 -->
    <insert id="insert" parameterType="com.example.pcim.entity.Visit">
        INSERT INTO prison_visit
        (prisoner_no, name, cell, visitor_name, visitor_id_card, relation, visit_time, remark, create_time, update_time)
        VALUES
        (#{prisonerNo}, #{name}, #{cell}, #{visitorName}, #{visitorIdCard}, #{relation}, #{visitTime}, #{remark}, NOW(), NOW())
    </insert>

    <!-- 更新探视登记，所有字段按需动态更新 -->
    <update id="update" parameterType="com.example.pcim.entity.Visit">
        UPDATE prison_visit SET
        <if test="prisonerNo != null">prisoner_no = #{prisonerNo},</if>
        <if test="name != null">name = #{name},</if>
        <if test="cell != null">cell = #{cell},</if>
        <if test="visitorName != null">visitor_name = #{visitorName},</if>
        <if test="visitorIdCard != null">visitor_id_card = #{visitorIdCard},</if>
        <if test="relation != null">relation = #{relation},</if>
        <if test="visitTime != null">visit_time = #{visitTime},</if>
        <if test="remark != null">remark = #{remark},</if>
        update_time = NOW()
        WHERE id = #{id}
    </update>

    <!-- 根据主键删除 -->
    <delete id="deleteById">
        DELETE FROM prison_visit WHERE id = #{id}
    </delete>

</mapper>
